# Copy to cre/.env (git-ignored).
# Wallet that sends the simulated report transaction on Arc Testnet (needs testnet USDC for gas: https://faucet.circle.com).
CRE_ETH_PRIVATE_KEY=0x...
# Agentcard sandbox credentials (agent-cards credentials --mode sandbox).
# To point the workflow at the local mock issuer instead, use mock_client_id / mock_client_secret
# and set agentcardBaseUrl in settlement/config.staging.json to http://localhost:3100/api/mock-agentcard
AGENTCARD_CLIENT_ID_ALL=
AGENTCARD_CLIENT_SECRET_ALL=
